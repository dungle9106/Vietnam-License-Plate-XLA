__pycache__/
*.pyc
.venv/
runs/
*.mp4

# Dữ liệu: bộ ảnh YOLO đã chia train/val/test (data/lp_full, ~1.1 GB, nguồn Kaggle
# tanhphp/vietnamese-license-plates) + bộ biển số đã gán nhãn tay (data/ocr_labels).
# data/paddle_rec tạo lại được bằng scripts/export_paddle_rec.py.
data/*
!data/lp_full/
!data/ocr_labels/
*.cache

# Mô hình: chỉ đưa weights/best.pt (YOLOv8s, 22 MB). Mô hình PaddleOCR tự tải khi chạy.
weights/*
!weights/best.pt

# Bản sao lưu / file nén tạm
_backup_*.zip
*.zip
